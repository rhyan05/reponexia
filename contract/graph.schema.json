{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reponexia.dev/contract/graph.schema.json",
  "title": "RepoNexia graph",
  "description": "Contrato entre o motor Rust e o orquestrador Python. Versão 1.0.",
  "type": "object",
  "required": ["schema_version", "root", "files"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "root": {
      "type": "string",
      "description": "Raiz absoluta do repositório analisado."
    },
    "repo_hash": {
      "type": "string",
      "description": "Hash do hash de todos os arquivos. Permite cache O(1)."
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "language", "loc", "hash"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Caminho relativo à raiz, sempre com '/' como separador."
          },
          "language": { "type": "string" },
          "loc": { "type": "integer", "minimum": 0 },
          "hash": { "type": "string" },
          "parse_errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "symbols":{
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "name", "kind", "line", "exported"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["function", "class", "method"] },
          "line": { "type": "integer", "minimum": 1 },
          "exported": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "edges":{
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind", "line"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string", "enum": ["import", "call", "extends", "implements"] },
          "symbol": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "fan_in", "fan_out", "page_rank"],
        "properties": {
          "path": { "type": "string" },
          "fan_in": { "type": "integer", "minimum": 0 },
          "fan_out": { "type": "integer", "minimum": 0 },
          "page_rank": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "evidence"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string", "enum": ["main", "bin", "console_script","package_main"] },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
